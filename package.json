{
  "name": "cuey",
  "productName": "Cuey",
  "version": "0.41.0",
  "description": "Simple video & slide playback for live events. One button. GO.",
  "author": "Avi Berger Productions",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:win": "electron-builder --win --x64",
    "dist": "electron-builder --mac --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aviberger.cuey",
    "productName": "Cuey",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Cuey-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Cuey-windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "fileAssociations": [
      {
        "ext": "cuey",
        "name": "Cuey Show",
        "role": "Editor"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "bergerman1-svg",
      "repo": "cuey"
    }
  },
  "repository": "https://github.com/bergerman1-svg/cuey",
  "homepage": "https://cuey.live"
}